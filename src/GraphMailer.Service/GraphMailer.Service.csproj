<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Declared here rather than only handed to the release build as a restore runtime flag.
      With packages.lock.json in place, a restore that the lock file already satisfies is
      skipped — RID-specific asset resolution included — so project.assets.json kept its
      RID-less shape and the ReadyToRun publish failed with NETSDK1047. Declaring the RID makes
      every restore resolve the same graph, so the lock file stops flip-flopping between Debug
      and Release restores and the release publish always finds its win-x64 target.
      The product is win-x64 only anyway (see CLAUDE.md).
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-GraphMailer.Service-92b035d8-09e5-4c64-a0d1-794e76280571</UserSecretsId>
    <AssemblyName>GraphMailer</AssemblyName>
    <RootNamespace>GraphMailer.Service</RootNamespace>
    <!-- Generated by tools\generate-icons.ps1 (shared base icon + play badge) -->
    <ApplicationIcon>Assets\graphmailer.ico</ApplicationIcon>
    <!-- Required for top-level return value in Program.cs -->
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <!-- Dev-only settings never belong in a deployment -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GraphMailer.Tests.Unit" />
    <InternalsVisibleTo Include="GraphMailer.Tests.Integration" />
    <InternalsVisibleTo Include="GraphMailer.Tests.Live" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="GraphMailer.ConfigTool" />
  </ItemGroup>

  <ItemGroup>
    <!-- All versions pinned (no floating "x.*"): floating versions made release
         builds non-reproducible over time and once combined with a stale
         ReadyToRun cache into a release whose DLLs didn't match its deps.json
         (Microsoft.Data.Sqlite 8.0.28 vs 8.0.29 → FileNotFoundException).
         Upgrade deliberately by bumping the version here. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- Explicit MSAL pin, must equal the one in GraphMailer.ConfigTool.csproj. Without it the
         Service takes whatever Azure.Identity drags in (4.83.1) while the ConfigTool pins a newer
         one — two deps.json in the same flat publish folder disagreeing over a single shipped DLL,
         with the publish order deciding which MSAL the service actually loads. Same failure class
         as the Microsoft.Data.Sqlite mismatch above, on the library that fetches Graph tokens. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.88.0" />
    <!-- Transitive via Microsoft.Identity.Client.Extensions.Msal, which still asks for 4.5.0 —
         a 2018 build whose newest asset is netstandard2.0, so the DLL shipped next to a net10.0
         application was a framework generation behind. 10.0.11 carries a real net10.0 asset.
         No advisory on 4.5.0; this is about shipping a runtime-matched binary. Safe to pin
         because the package is a two-method wrapper over the Windows DPAPI whose surface has
         not changed in years. Only the Service resolves it — the ConfigTool never does, so
         there is no shared-folder version to keep in sync. Drop the pin once Extensions.Msal
         asks for a current version itself. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <!-- Base SDK only (TelemetryClient) for the opt-in daily telemetry heartbeat —
         no ASP.NET/auto-collection packages. The 3.x line is a compatibility layer over
         OpenTelemetry, so it brings the OTel exporter and persistent-storage packages
         with it; that is expected, not accidental. -->
    <PackageReference Include="Microsoft.ApplicationInsights" Version="3.1.2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- No SQLitePCLRaw pin here any more: it existed because Microsoft.Data.Sqlite used to pull
         a bundled SQLite affected by CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, memory corruption) —
         2.1.6 on the 8.0.x line, still 2.1.11 on 10.0.10. Microsoft.Data.Sqlite 10.0.11 depends
         on SQLitePCLRaw 2.1.12 itself, which is the condition the old pin named for its own
         removal. Should a future Microsoft.Data.Sqlite ever resolve below 2.1.12 again, put the
         pin back. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Microsoft.Graph" Version="6.5.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <!-- Explicit Serilog pin: keeps the shared DLL identical to the one the
         ConfigTool references (both publish into the same release folder) -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SmtpServer" Version="11.1.0" />
    <!-- Server-side PNG rendering of the periodic-report daily-volume chart.
         Embedded as a CID inline image so it renders in Outlook Classic + new Outlook
         (both strip inline SVG). Platform-neutral (no System.Drawing/CA1416 on the
         Service's platform-agnostic net10.0 target). -->
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
  </ItemGroup>
</Project>
