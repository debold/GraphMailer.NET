<UserControl x:Class="GraphMailer.ConfigTool.Views.MessageRulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:GraphMailer.ConfigTool.Helpers"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Master switch first: everything below is inert without it, and an operator needs
                 to see that before wondering why a rule never fires. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock Text="Message Rules"
                                   Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,12,16,16">
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Rules inspect every message as it arrives and can change or refuse it before it is queued. They are evaluated in order, from top to bottom, and a rule applies when its conditions match."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox x:Name="EnabledBox" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="Enabled_Changed"/>
                            <TextBlock Text="Apply message rules to incoming mail"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="RuleCountLabel" Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                        <Border x:Name="EnforceNotice"
                                Visibility="Collapsed"
                                Background="#FFFFF4CE" BorderBrush="#FFEDBE00" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,12,0,0">
                            <TextBlock x:Name="EnforceNoticeText" TextWrapping="Wrap" Foreground="#FF7A5700"/>
                        </Border>

                        <Border x:Name="ProblemNotice"
                                Visibility="Collapsed"
                                Background="#FFFDE7E9" BorderBrush="#FFE81123" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,12,0,0">
                            <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Foreground="#FF8B0000"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Rules -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rules"
                                       Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="+ Add rule"
                                    Style="{StaticResource SmallPrimaryButton}"
                                    Click="AddRule_Click"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,12,16,16">
                        <DataGrid x:Name="RulesGrid"
                                  MinHeight="90" MaxHeight="320"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  AutoGenerateColumns="False"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="34"/>
                                <DataGridTemplateColumn Header="On" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Checked="RuleEnabled_Changed"
                                                      Unchecked="RuleEnabled_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*"/>
                                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80"/>
                                <DataGridTextColumn Header="When" Binding="{Binding MatchSummary}" Width="120"/>
                                <DataGridTextColumn Header="Actions" Binding="{Binding ActionSummary}" Width="2*"/>
                                <!-- One named column instead of two anonymous ones: both glyphs
                                     are rare, and a column with no header reads as broken. -->
                                <DataGridTextColumn Header="Notes"
                                                    Binding="{Binding NotesGlyphs}"
                                                    Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding NotesTooltip}"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- What "Refresh hits" below actually refreshes. A rule with no
                                     hits is either matching nothing or doing nothing. -->
                                <DataGridTextColumn Header="Hits (30 d)"
                                                    Binding="{Binding HitsDisplay}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="▲" Style="{StaticResource SmallButton}"
                                                        Padding="6,2" Height="22" Margin="0,0,4,0"
                                                        Click="MoveRuleUp_Click"/>
                                                <Button Content="▼" Style="{StaticResource SmallButton}"
                                                        Padding="6,2" Height="22" Margin="0,0,4,0"
                                                        Click="MoveRuleDown_Click"/>
                                                <Button Content="✎" Style="{StaticResource SmallButton}"
                                                        Padding="6,2" Height="22" Margin="0,0,4,0"
                                                        Click="EditRule_Click"/>
                                                <Button Content="✕" Style="{StaticResource SmallDangerButton}"
                                                        Padding="6,2" Height="22"
                                                        Click="RemoveRule_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Duplicate" Style="{StaticResource SmallButton}"
                                    Margin="0,0,8,0" Click="DuplicateRule_Click"/>
                            <Button Content="↺ Refresh hits" Style="{StaticResource SmallButton}"
                                    Margin="0,0,8,0" Click="RefreshHits_Click"/>
                            <!-- Its own window: the result is long, and the page is already so. -->
                            <Button Content="Test rules…" Style="{StaticResource SmallButton}"
                                    Click="OpenTester_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Limits -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock Text="Limits and Records"
                                   Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Label, input and explanation on one line each. Stacking the label above
                         the input left the explanation floating between the two with nothing to
                         align to; side by side there is one baseline per row. -->
                    <Grid Margin="16,14,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.Resources>
                            <Style x:Key="LimitLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,12,12"/>
                            </Style>
                            <!-- BasedOn keeps the theme's control template; a keyed style does not
                                 inherit the implicit one, and without it the box loses the rounded
                                 border every other input in the tool has. -->
                            <Style x:Key="LimitBox" TargetType="TextBox"
                                   BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Width" Value="110"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                            </Style>
                            <Style x:Key="LimitHint" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Body examined (kB)"
                                   Style="{StaticResource LimitLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MaxBodyScanKb"
                                 Style="{StaticResource LimitBox}"
                                 h:NumericField.Min="1" h:NumericField.Max="102400"
                                 TextChanged="AnyValue_Changed"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource LimitHint}"
                                   Text="How much of the message body conditions look at. A longer body is examined up to this point, not skipped."/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Pattern time limit (ms)"
                                   Style="{StaticResource LimitLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="RegexTimeoutMs"
                                 Style="{StaticResource LimitBox}"
                                 h:NumericField.Min="1" h:NumericField.Max="10000"
                                 TextChanged="AnyValue_Changed"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource LimitHint}"
                                   Text="How long a regular expression may run against one value. A pattern that exceeds it counts as no match, so a costly pattern cannot hold up a mail session."/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Keep records for (days)"
                                   Style="{StaticResource LimitLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="DiscardRetentionDays"
                                 Style="{StaticResource LimitBox}"
                                 h:NumericField.Min="1" h:NumericField.Max="3650"
                                 TextChanged="AnyValue_Changed"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource LimitHint}"
                                   Text="How long the record of a discarded message is kept. Separate from the malware page's setting, which applies even when scanning is switched off."/>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="StoreDiscardedBox" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" Click="AnyValue_Changed"/>
                                <TextBlock Text="Also store the full message when a rule discards it"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Margin="50,4,0,0"
                                       Text="A discarded message leaves no other trace — the sending application was told it was accepted. Off by default, because keeping every discarded message is a deliberate decision."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
