<UserControl x:Class="GraphMailer.ConfigTool.Views.AccessControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:GraphMailer.ConfigTool.Helpers"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- SMTP Users card -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="SMTP Users"
                                       Style="{StaticResource SectionHeader}"/>
                            <Button Grid.Column="1"
                                    Content="+ Add User"
                                    Style="{StaticResource SmallPrimaryButton}"
                                    Click="AddUser_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="UsersGrid"
                              Margin="0"
                              MinHeight="80"
                              MaxHeight="240"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Enabled"
                                                    Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Checked="UserEnabled_Changed"
                                                  Unchecked="UserEnabled_Changed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header=""
                                                    Width="28">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell"
                                           BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="Padding" Value="0,4"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="&#xE7BA;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="#FFC42B1C"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding PasswordWarningVisibility}"
                                                   ToolTip="This user's password could not be decrypted with the current key and is shown blank. Edit the user to re-enter it, then save."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Username"
                                                Binding="{Binding Username}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Display Name"
                                                Binding="{Binding DisplayName}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header=""
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Content="✎"
                                                    Style="{StaticResource SmallButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Margin="0,0,4,0"
                                                    Click="EditUser_Click"/>
                                            <Button Content="✕"
                                                    Style="{StaticResource SmallDangerButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Click="RemoveUser_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Allowed Senders card -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Allowed Senders"
                                           Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Leave empty to allow all authenticated users."
                                           Style="{StaticResource HintText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Add"
                                    Style="{StaticResource SmallPrimaryButton}"
                                    Click="AddSender_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="SendersGrid"
                              Margin="0"
                              MinHeight="40"
                              MaxHeight="240"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address / Pattern"
                                                Binding="{Binding Pattern}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header=""
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Content="✎"
                                                    Style="{StaticResource SmallButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Margin="0,0,4,0"
                                                    Click="EditSender_Click"/>
                                            <Button Content="✕"
                                                    Style="{StaticResource SmallDangerButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Click="RemoveSender_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Blocked Senders card -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Blocked Senders"
                                           Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="MAIL FROM addresses or patterns that are always rejected. Evaluated after the allow list."
                                           Style="{StaticResource HintText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Add"
                                    Style="{StaticResource SmallPrimaryButton}"
                                    Click="AddBlockedSender_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="BlockedSendersGrid"
                              Margin="0"
                              MinHeight="40"
                              MaxHeight="240"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address / Pattern"
                                                Binding="{Binding Pattern}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header=""
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Content="✎"
                                                    Style="{StaticResource SmallButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Margin="0,0,4,0"
                                                    Click="EditBlockedSender_Click"/>
                                            <Button Content="✕"
                                                    Style="{StaticResource SmallDangerButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Click="RemoveBlockedSender_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Microsoft 365 Sender Validation card -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Microsoft 365 Sender Validation"
                                       Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="SenderValidationRecBadge"
                                    Visibility="Collapsed"
                                    Background="#FFFFF4CE" BorderBrush="#FFEDBE00" BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="RecommendationBadge_Click"
                                    ToolTip="Open the Recommendations page.">
                                <TextBlock x:Name="SenderValidationRecBadgeText"
                                           Text="● Recommendation"
                                           FontSize="11"
                                           Foreground="#FF7A5700"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="16,12,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0"
                                      Grid.Column="0"
                                      Style="{StaticResource ToggleSwitch}"
                                      x:Name="SvEnabled"
                                      Checked="SvField_Changed"
                                      Unchecked="SvField_Changed"/>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="Validate senders against the Microsoft 365 tenant"
                                       Style="{StaticResource BodyText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>

                            <CheckBox Grid.Row="1"
                                      Grid.Column="0"
                                      Style="{StaticResource ToggleSwitch}"
                                      x:Name="SvFailClosed"
                                      IsEnabled="{Binding IsChecked, ElementName=SvEnabled}"
                                      Checked="SvField_Changed"
                                      Unchecked="SvField_Changed"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="Reject senders when validation is unavailable (fail-closed)"
                                       Style="{StaticResource BodyText}"
                                       ToolTip="Default off (fail-open): when Graph is unreachable or the permission is missing, senders are accepted unvalidated and an admin notification is sent.&#x0a;Enable to reject with 550 instead — note that an Entra outage then stops mail acceptance."
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>

                        </Grid>

                        <TextBlock Text="Rejects MAIL FROM addresses that are not known in the tenant (users, shared mailboxes, aliases) with an immediate 550 instead of failing later at Graph delivery. Aliases are resolved to the mailbox owner for sending. Requires the User.Read.All application permission on the Entra app registration. Senders without a mailbox of their own — distribution groups, public folders, mail users — are covered by Sender Routing below."
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12"/>

                        <StackPanel HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsChecked, ElementName=SvEnabled}">
                            <TextBlock Text="Refresh interval (minutes)"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="SvRefreshInterval"
                                     Width="200"
                                     Text="60"
                                     h:NumericField.Min="1"
                                     h:NumericField.Max="1440"
                                     ToolTip="How often the full tenant directory is re-synced (minutes).&#x0a;New mailboxes are also found on demand between syncs.&#x0a;Range: 1 – 1440 min (24 h)."
                                     TextChanged="SvText_Changed"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button x:Name="SvSyncNow"
                                    Content="&#x27F2; Sync now"
                                    Style="{StaticResource SmallButton}"
                                    IsEnabled="False"
                                    ToolTip="Asks the running service to re-sync the tenant directory immediately&#x0a;(picked up within a few seconds).&#x0a;Available while validation is enabled and the service is running."
                                    Margin="0,0,12,0"
                                    Click="SvSyncNow_Click"/>
                            <Button x:Name="SvShowDirectory"
                                    Content="Show synchronised senders"
                                    Style="{StaticResource SmallButton}"
                                    ToolTip="Opens a read-only list of every mailbox and group the last sync recognised,&#x0a;with their aliases — so you can check what is actually known before wondering&#x0a;why a sender is rejected."
                                    Margin="0,0,12,0"
                                    Click="SvShowDirectory_Click"/>
                            <TextBlock x:Name="SvSyncStatus"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="SvSyncWarning"
                                   Style="{StaticResource HintText}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- Sender Routing card -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sender Routing"
                                           Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Send as distribution groups, public folders and mail users."
                                           Style="{StaticResource HintText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="SrGenerateScript"
                                    Content="Generate SendAs script"
                                    Style="{StaticResource SmallButton}"
                                    ToolTip="Builds the Exchange Online PowerShell script that grants the relay mailbox SendAs&#x0a;on the objects it has to send for. Graph can neither set nor read that permission."
                                    Click="SrGenerateScript_Click"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,12,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0"
                                      Grid.Column="0"
                                      Style="{StaticResource ToggleSwitch}"
                                      x:Name="SrEnabled"
                                      Checked="SrField_Changed"
                                      Unchecked="SrField_Changed"/>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="Send as recipients that have no mailbox of their own"
                                       Style="{StaticResource BodyText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Microsoft 365 only accepts a real mailbox as the sending account. Mail from distribution groups, mail-enabled public folders and mail users is therefore sent through the relay mailbox below, keeping the original address in the From header. Exchange authorises that pairing via the SendAs permission, which has to be granted on each object to the relay mailbox — use the button above to generate the script. A shared mailbox works as the relay and needs no licence; it keeps no copy of relayed mail."
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12"/>

                        <StackPanel HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsChecked, ElementName=SrEnabled}">
                            <TextBlock Text="Relay mailbox"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="SrRelayMailbox"
                                     Width="320"
                                     ToolTip="UPN or primary SMTP address of an existing mailbox, e.g. relay@contoso.com."
                                     TextChanged="SrText_Changed"/>
                            <TextBlock x:Name="SrRelayMailboxError"
                                       Style="{StaticResource HintText}"
                                       Foreground="#FFC42B1C"
                                       Visibility="Collapsed"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Recognising these senders"
                                   Style="{StaticResource LabelText}"
                                   Margin="0,18,0,2"/>
                        <TextBlock Text="Only relevant while Microsoft 365 sender validation is on: without this, a group or public folder is rejected at MAIL FROM before routing ever sees it. Needs one more Graph permission — if the app registration predates it, run the Entra setup again on the Graph API page; it keeps the registration and certificate and only adds what is missing."
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0"
                                      Grid.Column="0"
                                      Style="{StaticResource ToggleSwitch}"
                                      x:Name="SvAcceptMailboxless"
                                      Checked="SrField_Changed"
                                      Unchecked="SrField_Changed"/>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="Accept groups, public folders and mail users as senders (needs Group.Read.All)"
                                       Style="{StaticResource BodyText}"
                                       ToolTip="Syncs distribution groups, mail-enabled security groups and Microsoft 365 groups into the directory, so they pass MAIL FROM.&#x0a;Mail-enabled public folders and dynamic distribution groups do not exist in Graph at all — for those, an address is accepted when its domain is one the tenant's own mailboxes and groups use.&#x0a;That last part is weaker than an address-exact check: a made-up address in an own domain passes too. Every external sender is still rejected.&#x0a;Requires the Group.Read.All application permission."
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="SrValidationHint"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource CardHeader}"
                            BorderThickness="0,1,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Routes (optional)"
                                           Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Only needed to pin a sender to a specific mailbox, or for senders Microsoft 365 cannot report."
                                           Style="{StaticResource HintText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Add"
                                    Style="{StaticResource SmallPrimaryButton}"
                                    IsEnabled="{Binding IsChecked, ElementName=SrEnabled}"
                                    Click="AddRoute_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="RoutesGrid"
                              Margin="0"
                              MinHeight="40"
                              MaxHeight="200"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              IsEnabled="{Binding IsChecked, ElementName=SrEnabled}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sender address / Pattern"
                                                Binding="{Binding Sender}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Send through mailbox"
                                                Binding="{Binding Mailbox}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header=""
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Content="&#x270E;"
                                                    Style="{StaticResource SmallButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Margin="0,0,4,0"
                                                    Click="EditRoute_Click"/>
                                            <Button Content="&#x2715;"
                                                    Style="{StaticResource SmallDangerButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Click="RemoveRoute_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <!-- Allowed Recipients card -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Allowed Recipients"
                                           Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Leave empty to allow any recipient domain."
                                           Style="{StaticResource HintText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Add"
                                    Style="{StaticResource SmallPrimaryButton}"
                                    Click="AddRecipient_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="RecipientsGrid"
                              Margin="0"
                              MinHeight="40"
                              MaxHeight="240"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address / Pattern"
                                                Binding="{Binding Pattern}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header=""
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Content="✎"
                                                    Style="{StaticResource SmallButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Margin="0,0,4,0"
                                                    Click="EditRecipient_Click"/>
                                            <Button Content="✕"
                                                    Style="{StaticResource SmallDangerButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Click="RemoveRecipient_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Blocked Recipients card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Blocked Recipients"
                                           Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="RCPT TO addresses or patterns that are always rejected. Evaluated after the allow list."
                                           Style="{StaticResource HintText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Add"
                                    Style="{StaticResource SmallPrimaryButton}"
                                    Click="AddBlockedRecipient_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="BlockedRecipientsGrid"
                              Margin="0"
                              MinHeight="40"
                              MaxHeight="240"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address / Pattern"
                                                Binding="{Binding Pattern}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header=""
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Content="✎"
                                                    Style="{StaticResource SmallButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Margin="0,0,4,0"
                                                    Click="EditBlockedRecipient_Click"/>
                                            <Button Content="✕"
                                                    Style="{StaticResource SmallDangerButton}"
                                                    Padding="6,2"
                                                    Height="22"
                                                    Click="RemoveBlockedRecipient_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
