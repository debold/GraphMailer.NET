<Window x:Class="GraphMailer.ConfigTool.Views.SenderDirectoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Synchronised senders"
        Width="900"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/graphmailer.ico"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="Everything the running service recognised during its last tenant sync — read-only. Click a column header to sort. The Domain rows are the tenant mail domains derived from those mailboxes and groups; they are what lets a mail-enabled public folder or a dynamic distribution group through, since Microsoft 365 does not expose either as an object. B2B guests are left out on purpose — they have no mailbox in this tenant and can never be a sender."/>

        <Grid Grid.Row="1"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     x:Name="FilterBox"
                     ToolTip="Filters on display name, primary address and every alias."
                     TextChanged="FilterBox_TextChanged"/>
            <TextBlock Grid.Column="1"
                       x:Name="CountText"
                       Style="{StaticResource HintText}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </Grid>

        <DataGrid Grid.Row="2"
                  x:Name="EntriesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  ClipboardCopyMode="IncludeHeader">
            <!-- Rows grow with the address list, so everything else lines up with its first line.
                 VerticalContentAlignment, not VerticalAlignment: the latter shrinks the cell itself
                 to its content, and the cell's bottom border then draws a second line across the
                 row above the actual row separator. -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell"
                       BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Kind}"
                                    Width="90"/>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding DisplayName}"
                                    Width="220"/>
                <DataGridTextColumn Header="Primary address"
                                    Binding="{Binding PrimaryAddress}"
                                    Width="260"/>
                <DataGridTextColumn Header="All addresses (primary + aliases)"
                                    Binding="{Binding AllAddresses}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="0,2,0,2"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource HintText}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Button Content="Close"
                    Style="{StaticResource PrimaryButton}"
                    IsCancel="True"
                    IsDefault="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
