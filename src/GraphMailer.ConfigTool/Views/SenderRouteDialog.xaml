<Window x:Class="GraphMailer.ConfigTool.Views.SenderRouteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sender Route"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/graphmailer.ico"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="24">

        <TextBlock Text="Sender address or pattern"
                   Style="{StaticResource LabelText}"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="SenderBox"
                 TextChanged="Field_TextChanged"/>
        <TextBlock Text="Exact address: reports@contoso.com — all addresses at a domain: @contoso.com"
                   Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,14"/>

        <TextBlock Text="Send through mailbox"
                   Style="{StaticResource LabelText}"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="MailboxBox"
                 TextChanged="Field_TextChanged"/>
        <TextBlock Text="UPN or primary SMTP address of a real mailbox that holds SendAs on the sender above."
                   Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"/>

        <TextBlock x:Name="ErrorText"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Abbrechen"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Ok_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
