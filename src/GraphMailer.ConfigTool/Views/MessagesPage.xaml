<UserControl x:Class="GraphMailer.ConfigTool.Views.MessagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <!-- List on the left, the selected message's details and timeline on the right. The right
         card only appears while a row is selected, so the list keeps the full width otherwise. -->
    <Grid Margin="24,20,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"
                              MinWidth="420"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Bottom padding = the card's corner radius: the grid paints an opaque background
             and would otherwise cover the rounded bottom corners (the header solves the same
             problem with its own CornerRadius, which a DataGrid cannot carry). -->
        <Border Grid.Column="0"
                Padding="0,0,0,8"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"
                                   MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Toolbar ─────────────────────────────────────────────────── -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Show"
                                       Style="{StaticResource LabelText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="FolderSelect"
                                      Width="140"
                                      ToolTip="Delayed: delivered late or still retrying.&#x0a;Rejected: refused during the SMTP session or discarded by a rule."
                                      SelectionChanged="Folder_Changed"/>
                        </StackPanel>

                        <!-- Fills the toolbar's free space: the searched values are addresses and
                             subjects, which are long — a narrow box hides what was typed. -->
                        <Grid Grid.Column="2"
                              MinWidth="200"
                              HorizontalAlignment="Stretch">
                            <TextBox x:Name="SearchBox"
                                     VerticalAlignment="Center"
                                     Padding="6,4,26,4"
                                     ToolTip="Searches every message, not just the loaded ones.&#x0a;Matches sender, recipient, subject, status, client IP, message id and the steps of its history."
                                     TextChanged="Search_Changed"/>
                            <TextBlock Text="Search…"
                                       Foreground="#FF888888"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}"
                                                         Value="">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="SearchClear"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="22"
                                    Margin="0,0,3,0"
                                    Padding="0"
                                    Content="&#x2715;"
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    ToolTip="Clear search"
                                    Click="SearchClear_Click">
                                <Button.Style>
                                    <!-- No BasedOn: the app has no implicit Button style, only keyed ones -->
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}"
                                                         Value="">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- No refresh button: the page reloads itself every 5 seconds while it is
                             visible. Selecting a row opens the details, their ✕ closes them. -->
                        <TextBlock x:Name="CountText"
                                   Grid.Column="4"
                                   Style="{StaticResource HintText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ── Message grid ─────────────────────────────────────────────── -->
                <DataGrid x:Name="MessagesGrid"
                          Grid.Row="1"
                          Margin="0"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          AutoGenerateColumns="False"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="MessagesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Received"
                                            Binding="{Binding ReceivedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                            Width="140"/>
                        <!-- Coloured pill, same treatment as the level column on the Logs page -->
                        <DataGridTemplateColumn Header="Status"
                                                Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3"
                                            Padding="6,1"
                                            Background="{Binding StatusBg}"
                                            HorizontalAlignment="Left"
                                            Margin="2,1">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="{Binding StatusFg}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="From"
                                            Binding="{Binding From}"
                                            Width="180"/>
                        <DataGridTextColumn Header="To"
                                            Binding="{Binding To}"
                                            Width="180"/>
                        <DataGridTextColumn Header="Subject"
                                            Binding="{Binding Subject}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Attempts"
                                            Binding="{Binding Attempts}"
                                            Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pages another block of messages in. Collapsed while the loaded rows already
                     cover everything. -->
                <Button x:Name="LoadMoreButton"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,2"
                        Style="{StaticResource SmallButton}"
                        Click="LoadMore_Click"/>

                <TextBlock x:Name="EmptyHint"
                           Grid.Row="3"
                           Style="{StaticResource HintText}"
                           TextWrapping="Wrap"
                           Margin="16,8,16,4"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ── Details + timeline ─────────────────────────────────────────────── -->
        <Border x:Name="MessageDetails"
                Grid.Column="1"
                Width="480"
                Margin="16,0,0,0"
                Visibility="Collapsed"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: subject, status pill, close -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetailSubjectValue"
                                   Grid.Column="0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="DetailStatusPill"
                                Grid.Column="1"
                                CornerRadius="3"
                                Padding="8,2"
                                Margin="10,0,6,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="DetailStatus"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="MessageDetailsClose"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Width="22"
                                Height="22"
                                Padding="0"
                                Content="&#x2715;"
                                FontSize="10"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Focusable="False"
                                ToolTip="Close details"
                                Click="MessageDetailsClose_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12,16,16">
                        <!-- The answer to "was it delivered, and when?" -->
                        <TextBlock x:Name="DetailSummary"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <Button x:Name="CopySummaryButton"
                                    Content="Copy summary"
                                    Style="{StaticResource SmallButton}"
                                    ToolTip="Copies the summary with subject, sender, recipient and times, for a reply to whoever asked"
                                    Click="CopySummary_Click"/>
                            <TextBlock x:Name="CopyConfirm"
                                       Text="Copied"
                                       Style="{StaticResource HintText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <Border x:Name="HistoryHint"
                                Style="{StaticResource WarnBox}"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="12"
                                       Text="History incomplete: this message was handled before GraphMailer 1.6.0 recorded each step. Shown are its receipt, the last failed attempt and the result."/>
                        </Border>

                        <!-- Label/value raster -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style x:Key="DetailLabel"
                                       TargetType="TextBlock"
                                       BasedOn="{StaticResource LabelText}">
                                    <Setter Property="Margin"
                                            Value="0,2,10,2"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Top"/>
                                </Style>
                                <Style x:Key="DetailValue"
                                       TargetType="TextBlock">
                                    <Setter Property="Margin"
                                            Value="0,2,0,2"/>
                                    <Setter Property="FontSize"
                                            Value="12.5"/>
                                    <Setter Property="TextWrapping"
                                            Value="Wrap"/>
                                </Style>
                                <ContextMenu x:Key="CopyMenu">
                                    <MenuItem Header="Copy"
                                              Click="DetailCopy_Click"/>
                                </ContextMenu>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Text="From" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailFrom" Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" ContextMenu="{StaticResource CopyMenu}"/>
                            <TextBlock Grid.Row="1" Text="To" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailTo" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" ContextMenu="{StaticResource CopyMenu}"/>
                            <TextBlock Grid.Row="2" Text="Received" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailReceived" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="3" Text="Delivered" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailSent" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="4" Text="Client" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailClientIp" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="5" Text="Attempts" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailAttempts" Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="6" Text="Next retry" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailNextRetry" Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                            <TextBlock Grid.Row="7" Text="Message-ID" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailMessageId" Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValue}" ContextMenu="{StaticResource CopyMenu}" ToolTip="Right-click to copy"/>
                            <TextBlock Grid.Row="8" Text="Queue ID" Style="{StaticResource DetailLabel}"/>
                            <TextBlock x:Name="DetailQueueId" Grid.Row="8" Grid.Column="1" Style="{StaticResource DetailValue}" ContextMenu="{StaticResource CopyMenu}" ToolTip="Right-click to copy"/>
                        </Grid>

                        <TextBlock Text="Timeline"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0,8,0,6"/>

                        <!-- Time · dot with connecting line · what happened. Section headings
                             (SMTP / Processing / Delivery) sit above the first line of each section. -->
                        <ItemsControl x:Name="TimelineList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Group}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="78,6,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasGroup}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,6,0">
                                                <TextBlock Text="{Binding TimeText}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DateText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <Rectangle Grid.Column="1"
                                                       Width="2"
                                                       Fill="{StaticResource BorderBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,14,0,0"/>
                                            <Ellipse Grid.Column="1"
                                                     Width="11"
                                                     Height="11"
                                                     Fill="{Binding DotBrush}"
                                                     VerticalAlignment="Top"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,3,0,0"/>
                                            <StackPanel Grid.Column="2"
                                                        Margin="6,0,0,12">
                                                <TextBlock Text="{Binding Summary}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDetail}"
                                                                             Value="True">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
