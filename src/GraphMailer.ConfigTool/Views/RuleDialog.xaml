<Window x:Class="GraphMailer.ConfigTool.Views.RuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule"
        Width="760"
        Height="720"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/graphmailer.ico"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="24">

        <!-- Buttons pinned to the bottom: the grids in the middle grow with the rule -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Ok_Click"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <CheckBox x:Name="EnabledBox" Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center" Click="Validate"/>
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource TextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Disabled"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=EnabledBox}" Value="True">
                                        <Setter Property="Text" Value="Enabled"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="Name" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" TextChanged="Validate"/>

                <TextBlock Text="Note (optional)" Style="{StaticResource LabelText}" Margin="0,12,0,4"/>
                <TextBox x:Name="DescriptionBox" TextChanged="Validate"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mode" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed">
                            <ComboBoxItem Tag="Audit">Audit — only log what would happen</ComboBoxItem>
                            <ComboBoxItem Tag="Enforce">Enforce — apply the actions</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Apply when" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="MatchBox" SelectionChanged="Match_Changed">
                            <ComboBoxItem Tag="All">all conditions are true</ComboBoxItem>
                            <ComboBoxItem Tag="Any">any condition is true</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border x:Name="EnforceNotice"
                        Visibility="Collapsed"
                        Background="#FFFFF4CE" BorderBrush="#FFEDBE00" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FF7A5700"
                               Text="In Enforce mode this rule changes or refuses live mail as soon as it is saved. Audit mode logs what it would do without touching anything, which is the safer way to introduce a rule."/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox x:Name="StopProcessingBox" Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center" Click="Validate"/>
                    <TextBlock Text="Stop after this rule — do not evaluate the rules below it"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Margin="50,4,0,0"
                           Text="This applies in Audit mode too, so an audit run follows exactly the same path enforcement would."/>

                <!-- Conditions -->
                <Grid Margin="0,20,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Conditions" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+ Add condition"
                            Style="{StaticResource SmallPrimaryButton}"
                            Click="AddCondition_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Text="Without conditions the rule applies to every message."/>
                <DataGrid x:Name="ConditionsGrid"
                          MinHeight="70" MaxHeight="180"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Condition" Binding="{Binding Summary}" Width="*"/>
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✎" Style="{StaticResource SmallButton}"
                                                Padding="6,2" Height="22" Margin="0,0,4,0"
                                                Click="EditCondition_Click"/>
                                        <Button Content="✕" Style="{StaticResource SmallDangerButton}"
                                                Padding="6,2" Height="22"
                                                Click="RemoveCondition_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Actions -->
                <Grid Margin="0,20,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Actions" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+ Add action"
                            Style="{StaticResource SmallPrimaryButton}"
                            Click="AddAction_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Text="Actions run top to bottom. Reject and Discard end the rule — anything below them never runs."/>
                <DataGrid x:Name="ActionsGrid"
                          MinHeight="70" MaxHeight="200"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Action" Binding="{Binding Summary}" Width="*"/>
                        <DataGridTextColumn Header="" Binding="{Binding WarningGlyph}" Width="28"/>
                        <DataGridTemplateColumn Header="" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="▲" Style="{StaticResource SmallButton}"
                                                Padding="6,2" Height="22" Margin="0,0,4,0"
                                                Click="MoveActionUp_Click"/>
                                        <Button Content="▼" Style="{StaticResource SmallButton}"
                                                Padding="6,2" Height="22" Margin="0,0,4,0"
                                                Click="MoveActionDown_Click"/>
                                        <Button Content="✎" Style="{StaticResource SmallButton}"
                                                Padding="6,2" Height="22" Margin="0,0,4,0"
                                                Click="EditAction_Click"/>
                                        <Button Content="✕" Style="{StaticResource SmallDangerButton}"
                                                Padding="6,2" Height="22"
                                                Click="RemoveAction_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
