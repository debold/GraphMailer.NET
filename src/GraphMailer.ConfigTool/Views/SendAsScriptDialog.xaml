<Window x:Class="GraphMailer.ConfigTool.Views.SendAsScriptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grant SendAs to the relay mailbox"
        Width="820"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/graphmailer.ico"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource HintText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"
                   Text="Microsoft Graph can neither grant nor read the SendAs permission, so this step runs in Exchange Online PowerShell. Copy or save the script below and run it as an Exchange administrator. Exchange replicates permission changes lazily — allow up to an hour before testing."/>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,12">
            <RadioButton x:Name="ScopeAll"
                         GroupName="Scope"
                         IsChecked="True"
                         Checked="Scope_Changed"
                         Content="All mail-enabled objects (recommended)"/>
            <TextBlock Style="{StaticResource HintText}"
                       TextWrapping="Wrap"
                       Margin="22,2,0,10"
                       Text="Covers every distribution group, mail-enabled public folder and mail user. Re-runnable, so objects created later are picked up by running it again — and it is the only variant that reaches public folders, which Graph cannot list."/>

            <RadioButton x:Name="ScopeSelected"
                         GroupName="Scope"
                         Checked="Scope_Changed"
                         Content="Only the objects I select"/>
            <TextBlock Style="{StaticResource HintText}"
                       TextWrapping="Wrap"
                       Margin="22,2,0,0"
                       Text="Keeps the relay mailbox from being able to send as everything, but needs re-generating whenever the set changes."/>
        </StackPanel>

        <Border Grid.Row="2"
                x:Name="SelectionPanel"
                Visibility="Collapsed"
                Style="{StaticResource Card}"
                Margin="0,0,0,12">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Button x:Name="LoadGroups"
                            Content="Load groups from Microsoft 365"
                            Style="{StaticResource SmallButton}"
                            Margin="0,0,12,0"
                            Click="LoadGroups_Click"/>
                    <TextBlock x:Name="LoadStatus"
                               Style="{StaticResource HintText}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <ListBox x:Name="GroupList"
                         Height="120"
                         SelectionMode="Multiple"
                         SelectionChanged="GroupList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Address, Mode=OneWay}"
                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Additional addresses (one per line)"
                           Style="{StaticResource LabelText}"
                           Margin="0,12,0,4"/>
                <TextBox x:Name="ExtraAddresses"
                         Height="64"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="ExtraAddresses_TextChanged"/>
                <TextBlock Style="{StaticResource HintText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="For mail-enabled public folders, dynamic distribution groups and mail users — Graph cannot list any of them, so enter their addresses here."/>
            </StackPanel>
        </Border>

        <TextBox Grid.Row="3"
                 x:Name="ScriptBox"
                 FontFamily="Cascadia Mono, Consolas, monospace"
                 FontSize="12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock x:Name="ActionStatus"
                       Style="{StaticResource HintText}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <Button Content="Copy"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Click="Copy_Click"/>
            <Button Content="Save as .ps1"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Click="Save_Click"/>
            <Button Content="Close"
                    Style="{StaticResource PrimaryButton}"
                    IsCancel="True"
                    IsDefault="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
