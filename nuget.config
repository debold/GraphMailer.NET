<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Package sources for this repository, independent of whatever is configured on the machine.

    <clear /> is the point of this file: without it, NuGet merges the user-level and
    machine-level nuget.config, so any feed configured there — a corporate mirror, a leftover
    local folder, a source added by another tool — becomes a candidate for resolving this
    project's dependencies. A build must not depend on which machine it runs on, and a package
    named like one of ours must not be resolvable from somewhere we never chose.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Where the sources above may pull from. Mirrors <clear /> for the mapping table: with a
    single source this is mostly documentation, but it means adding a second feed later forces
    a deliberate decision about which package IDs it is allowed to serve, instead of letting it
    compete for every ID in the graph.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
